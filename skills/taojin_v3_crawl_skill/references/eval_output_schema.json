{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Eval Output Schema",
  "description": "Schema for SPU/SKU extraction evaluation output produced by eval_spu_extraction.py",
  "type": "object",
  "required": [
    "n_samples",
    "overall",
    "dimension_summary",
    "per_sku"
  ],
  "properties": {
    "n_samples": {
      "type": "integer",
      "description": "Number of samples evaluated"
    },
    "overall": {
      "type": "object",
      "description": "Overall weighted evaluation metrics",
      "required": [
        "precision",
        "recall",
        "f1",
        "total_weight",
        "weighted_tp",
        "weighted_fp",
        "weighted_fn"
      ],
      "properties": {
        "precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "f1": { "type": "number", "minimum": 0, "maximum": 1 },
        "total_weight": { "type": "number" },
        "weighted_tp": { "type": "number" },
        "weighted_fp": { "type": "number" },
        "weighted_fn": { "type": "number" }
      }
    },
    "dimension_summary": {
      "type": "object",
      "description": "Per-dimension evaluation summary across all samples",
      "patternProperties": {
        "^(sku_id|price|source_item_name|review|descriptions|spu_pics|sku_pics)$": {
          "type": "object",
          "required": [
            "precision",
            "recall",
            "f1",
            "weight",
            "tp",
            "fp",
            "fn"
          ],
          "properties": {
            "precision": { "type": "number", "minimum": 0, "maximum": 1 },
            "recall": { "type": "number", "minimum": 0, "maximum": 1 },
            "f1": { "type": "number", "minimum": 0, "maximum": 1 },
            "weight": { "type": "number" },
            "tp": { "type": "integer", "minimum": 0 },
            "fp": { "type": "integer", "minimum": 0 },
            "fn": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "per_sku": {
      "type": "array",
      "description": "Per-SKU evaluation results",
      "items": {
        "type": "object",
        "required": ["index", "dimensions", "overall"],
        "properties": {
          "index": { "type": "integer" },
          "dimensions": {
            "type": "object",
            "patternProperties": {
              "^(sku_id|price|source_item_name|review|descriptions|spu_pics|sku_pics)$": {
                "type": "object",
                "required": ["tp", "fp", "fn", "precision", "recall", "f1", "weight"],
                "properties": {
                  "tp": { "type": "integer", "minimum": 0 },
                  "fp": { "type": "integer", "minimum": 0 },
                  "fn": { "type": "integer", "minimum": 0 },
                  "precision": { "type": "number", "minimum": 0, "maximum": 1 },
                  "recall": { "type": "number", "minimum": 0, "maximum": 1 },
                  "f1": { "type": "number", "minimum": 0, "maximum": 1 },
                  "weight": { "type": "number" }
                }
              }
            }
          },
          "overall": {
            "type": "object",
            "required": [
              "precision",
              "recall",
              "f1",
              "total_weight",
              "weighted_tp",
              "weighted_fp",
              "weighted_fn"
            ],
            "properties": {
              "precision": { "type": "number", "minimum": 0, "maximum": 1 },
              "recall": { "type": "number", "minimum": 0, "maximum": 1 },
              "f1": { "type": "number", "minimum": 0, "maximum": 1 },
              "total_weight": { "type": "number" },
              "weighted_tp": { "type": "number" },
              "weighted_fp": { "type": "number" },
              "weighted_fn": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
