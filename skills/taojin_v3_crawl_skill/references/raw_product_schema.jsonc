// Raw Product Schema (Stage1 原始产品数据)
// 这是 Stage1 从页面直接提取的原始数据格式
// 包含所有原始字段，未经过后处理标准化

{
  // === 基本信息 ===
  "source_url": "https://example.com/products/sample-product",  // 产品页面 URL
  "source_item_name": "Sample Product Title",  // 产品标题（原始文本）

  // === 图片 ===
  "source_pics": [  // 产品图片 URL 列表（原始顺序）
    "https://cdn.example.com/product1.jpg",
    "https://cdn.example.com/product2.jpg"
  ],

  // === 描述 ===
  "descriptions": [  // 产品描述段落列表（原始 HTML 或文本）
    "Product description paragraph 1...",
    "Product description paragraph 2..."
  ],

  // === 价格（原始格式，可能带货币符号）===
  "source_origin_price": "$59.99",  // 原价（原始字符串）
  "source_activity_price": "$39.99",  // 活动价/现价（原始字符串）
  "source_price_currency": "USD",  // 货币（原始值，可能是符号或代码）

  // === SPU 属性 ===
  "props": {  // SPU 级别的属性字典
    "Brand": "ExampleBrand",
    "Category": "Electronics"
  },

  // === 状态 ===
  "status": 1,  // 上架状态：1=在售，0=下架

  // === SKU 列表（原始数据）===
  "skus": [
    {
      // SKU 标识
      "sku_id": "sku-001",  // SKU ID（可选）

      // SKU 属性
      "sku_props": {  // SKU 级别属性
        "Color": "Red",
        "Size": "M"
      },

      // SKU 价格（原始格式）
      "source_origin_price": "$59.99",
      "source_activity_price": "$39.99",
      "source_price_currency": "USD",

      // SKU 图片
      "source_pics": [
        "https://cdn.example.com/sku-red-1.jpg"
      ],

      // SKU 状态
      "status": 1  // 1=在售，0=下架
    }
  ],

  // === Review Stats（可选，仅 when with_review_stats）===
  "source_score": 4.5,  // 评分（可选）
  "source_cmms": 128,   // 评论数（可选）

  // === 特殊标记 ===
  "not_detail": null,  // 非详情页标记："yes", "deadlink" 等，null 表示是正常 PDP

  // === 内部投影字段（用于 SKU → SPU 属性投影）===
  "_projection_mode": "all",  // 投影模式：all/none/include/exclude
  "_projection_props": [],    // 投影属性列表（include/exclude 模式使用）

  // === 额外元数据（可选）===
  "_raw_meta": {  // 原始元数据，不参与后处理
    "page_title": "...",
    "extracted_at": "2024-01-01T00:00:00Z"
  }
}
