// Target Product Schema (Stage1 后处理后的目标格式 / Stage2/3 输出格式)
// 这是经过 postprocess_raw_product.py 标准化后的目标格式
// 也是 stage2_script_res.json 和 final_code.py 的 script_res 必须遵循的格式

{
  // ======== 必填字段（MUST） ========
  // 所有 key 必须存在，值为 null 表示缺失，不可省略 key

  // === 基本信息 ===
  "source_url": "https://example.com/products/sample-product",
    // string: 产品页面 URL（绝对 URL）

  "source_item_name": "Sample Product Title",
    // string: 产品标题

  // === 图片 ===
  "source_pics": [
    // Array<string>: 产品图片 URL 列表（绝对 URL）
    // SPU 级别的主图库
    "https://cdn.example.com/product1.jpg",
    "https://cdn.example.com/product2.jpg"
  ],

  // === 描述 ===
  "descriptions": [
    // Array<string>: 产品描述段落列表
    // 每一项可以是纯文本或 HTML 字符串
    "Product description paragraph 1...",
    "Product description paragraph 2..."
  ],

  // === 价格（标准化为数字）===
  "source_origin_price": 59.99,
    // number | null: 原价
    // 显示 Free / $0 / 0 时标准化为 0
    // 缺失时为 null，不可为空字符串

  "source_activity_price": 39.99,
    // number | null: 活动价/现价

  "source_price_currency": "USD",
    // string | null: 货币代码（3 位大写，如 USD/CNY/EUR）
    // 从 market/currency/locale 推断，可来自 API/inline state/cookie/header

  // === SPU 属性 ===
  "props": {},
    // object: SPU 级别的属性字典
    // SPU 无属性时为 {}（空对象），不可为 null 或省略
    // key 为属性名，value 为属性值

  // === 状态 ===
  "status": 1,
    // integer: 上架状态
    // 1 = on-shelf（在售）
    // 0 = off-shelf（下架/缺货）

  // === SKU 列表 ===
  "skus": [
    // Array<object>: SKU 列表
    // 单 SKU PDP 如只有一个空 props 的 SKU，应折叠到 SPU 层（skus 长度为 0 或 1 个空 props）

    {
      // === SKU 属性（必填）===
      "sku_props": {
        // object: SKU 级别的属性字典
        // SKU 无属性时至少包含 SKU/Model 等业务标识
        // 单 SKU 折叠后此对象可能为空
        "Color": "Red",
        "Size": "M"
      },

      // === SKU 价格（必填）===
      "source_origin_price": 59.99,
        // number | null: SKU 原价

      "source_activity_price": 39.99,
        // number | null: SKU 活动价

      "source_price_currency": "USD",
        // string | null: SKU 货币（通常与 SPU 一致）

      // === SKU 图片（必填）===
      "source_pics": [
        // Array<string>: SKU 级别的图片 URL 列表
        // 变体图片，可从 swatch/option 的 data-id/data-variant-id 等映射得到
        "https://cdn.example.com/sku-red-1.jpg"
      ],

      // === SKU 状态（必填）===
      "status": 1,
        // integer: SKU 上架状态
        // 1 = 在售
        // 0 = 下架/缺货/不可用

      // === SKU 标识（可选）===
      "sku_id": "sku-001"
        // string | undefined: SKU ID（可选）
    }
  ],

  // ======== 可选字段（OPTIONAL） ========

  // === Review Stats（仅 with_review_stats 时填写）===
  "source_score": null,
    // number | null: 产品评分
    // type != "with_review_stats" 时必须为 null

  "source_cmms": null,
    // number | null: 评论数
    // type != "with_review_stats" 时必须为 null

  // === 特殊标记 ===
  "not_detail": null,
    // string | null: 非详情页标记
    // 可选值："yes", "deadlink" 等
    // null 表示是正常 PDP

  // ======== 后处理添加的字段 ========
  // （Stage1 后处理后添加，Stage2/3 可能不包含）

  "default_sku_index": 0,
    // number | undefined: 默认选中的 SKU 索引
    // 由 select_default_sku 计算

  "effective_price": 39.99,
    // number | undefined: 生效价格（默认 SKU 的价格）

  "_projection_mode": "all",
    // string: SKU 属性投影模式
    // all / none / include / exclude

  "_projection_props": []
    // Array<string>: 投影属性列表
}

// ======== 字段规则说明 ========
//
// 1. 所有 key 必须存在，值为 null 表示缺失，不可省略 key
// 2. 价格字段必须为数字（number），不能是字符串
// 3. 货币必须是 3 位大写 ISO 代码
// 4. props 和 skus[].sku_props 必须是 dict（对象），不能是 null
// 5. source_pics 和 skus[].source_pics 必须是绝对 URL 列表
// 6. status 必须是整数（0 或 1）
// 7. 单 SKU 与多 SKU case 必须分别处理，不可混淆
// 8. Free/$0/0 显示时标准化为数字 0
// 9. 缺失字段设为 null，不要省略或设为空字符串
